{
  "info": {
    "_postman_id": "2c8a71d0-6f3b-4a91-9e14-7b12c3d4e501",
    "name": "Mark85 API - QA Validation",
    "description": "Postman v2.1 collection for the Mark85 Node.js/MongoDB REST API supporting sequential Collection Runner execution.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "apiUrl",
      "value": "http://localhost:3333",
      "type": "string"
    },
    {
      "key": "userName",
      "value": "Luis Brandao",
      "type": "string"
    },
    {
      "key": "userEmail",
      "value": "qa.mark85@lfernandobra.dev",
      "type": "string"
    },
    {
      "key": "userPassword",
      "value": "pwd123",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Users & Sessions",
      "item": [
        {
          "name": "POST /users - Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uniqueEmail = `qa.${Date.now()}.${Math.floor(Math.random() * 1000)}@lfernandobra.dev`;",
                  "pm.collectionVariables.set('userEmail', uniqueEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User created with 2xx status', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{apiUrl}}/users",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
        {
          "name": "POST /sessions - Authenticate & Capture Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns JWT token and stores authToken', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token').that.is.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('authToken', json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{apiUrl}}/sessions",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "sessions"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "POST /tasks - Create Task with Tags",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Saves created task ID if returned', function () {",
                  "    try {",
                  "        const json = pm.response.json();",
                  "        if (json && json._id) { pm.collectionVariables.set('taskId', json._id); }",
                  "    } catch (e) {}",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Robot Framework API Validation\",\n  \"tags\": [\"robot\", \"api\", \"qa\"]\n}"
            },
            "url": {
              "raw": "{{apiUrl}}/tasks",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "tasks"
              ]
            }
          }
        },
        {
          "name": "GET /tasks - List User Tasks",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns array and captures taskId', function () {",
                  "    const list = pm.response.json();",
                  "    pm.expect(list).to.be.an('array').and.not.empty;",
                  "    pm.collectionVariables.set('taskId', list[0]._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{authToken}}"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/tasks",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "tasks"
              ]
            }
          }
        },
        {
          "name": "PUT /tasks/:task_id/done - Mark Task Done",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 2xx', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "{{authToken}}"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/tasks/{{taskId}}/done",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}",
                "done"
              ]
            }
          }
        },
        {
          "name": "PUT /tasks/:task_id/todo - Reopen Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 2xx', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "{{authToken}}"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/tasks/{{taskId}}/todo",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}",
                "todo"
              ]
            }
          }
        },
        {
          "name": "DELETE /tasks/:task_id - Delete Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 2xx', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "{{authToken}}"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/tasks/{{taskId}}",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
